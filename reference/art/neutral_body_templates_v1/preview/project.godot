; Standalone, read-only reference viewer. This is not the FLUX game project.
config_version=5

[application]
config/name="FLUX - Neutral Body Reference Viewer"
run/main_scene="res://viewer.tscn"
run/max_fps=120

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/size/min_width=960
window/size/min_height=600
window/stretch/mode="canvas_items"
window/vsync/vsync_mode=0

[physics]
common/physics_ticks_per_second=120

[rendering]
renderer/rendering_method="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.067, 0.09, 0.11, 1)
