static func float_duration_ms(body_type: String) -> int:
	match body_type:
		"small": return FLOAT_SMALL_DURATION_MS
		"large": return FLOAT_LARGE_DURATION_MS
	return FLOAT_MIDDLE_DURATION_MS


static func compatibility_hash() -> String:
