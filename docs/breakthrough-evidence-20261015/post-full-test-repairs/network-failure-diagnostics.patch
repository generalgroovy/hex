+	print("IMPAIRMENT_CAPTURE_DIAGNOSTIC chemistry_bytes=%d shape=%s" % [DiagnosticChemistry.encoded_size(chemistry), str(DiagnosticChemistry._snapshot_shape_valid(chemistry))])
