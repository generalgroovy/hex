+func _hint_choose_menu_entry(game: Node, viewport: SubViewport, target_id: String) -> void:
+	var rows: Array[Dictionary] = game.local_navigation.entries()
+	var target := -1
+	var target_count := 0
+	for index: int in rows.size():
+		if String(rows[index].id) == target_id:
+			target = index
+			target_count += 1
+	check(target_count == 1, "Menu exposes exactly one requested action: " + target_id)
+	if target_count != 1: return
+	var steps: int = posmod(target - int(game.local_navigation.selected), rows.size())
+	for index: int in steps:
+		_hint_key(viewport, KEY_DOWN, true)
+		_hint_key(viewport, KEY_DOWN, false)
+	var selected: int = int(game.local_navigation.selected)
+	var current_rows: Array[Dictionary] = game.local_navigation.entries()
+	var on_target: bool = game.local_navigation.menu_open and selected >= 0 and selected < current_rows.size() \
+		and String(current_rows[selected].id) == target_id
+	check(on_target, "actual keyboard navigation reaches the requested Menu action: " + target_id)
+	if not on_target: return
+	_hint_key(viewport, KEY_ENTER, true)
+	_hint_key(viewport, KEY_ENTER, false)
+
+
 func _hint_key(viewport: SubViewport, keycode: int, pressed: bool, shifted: bool = false) -> void:
 	var event := InputEventKey.new()
 	event.physical_keycode = keycode
