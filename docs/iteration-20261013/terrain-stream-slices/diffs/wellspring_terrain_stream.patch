+	_validation_jobs[id] = {"phase": VALIDATION_COLLECTED, "image": image,
+		"size": size, "expected_hash": String(record.rgba_sha256), "path": String(record.path),
+		"bytes": size.x * size.y * 4, "pixels": PackedByteArray(), "offset": 0, "context": null}
