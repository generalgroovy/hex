.godot/
.autocode/*
!.autocode/roles.toml
*.import
# The shared skeleton validator checks exact decoded RGBA; preserve these
# lossless import settings instead of recreating alpha-border repair defaults.
!assets/sprites/wireframe_motion_v2/*.png.import
*.pyc
__pycache__/
build/
exports/
reports/
node_modules/
*.lnk

# Local validation archives contain generated profiles/caches; originals remain local.
/docs/evidence/
/.agent/verification/
/.codex/
# Curated portable payloads are delivered separately from Git source.

# Reviewed evidence mirrors the original receipt-relative paths. Unignore only
# these curated bundles, not the live engine/export trees. Profiles and payloads
# remain excluded even inside a bundle.
!docs/verification/hex-vision-20260920/.godot/
!docs/verification/hex-vision-20260920/.godot/**
!docs/verification/hex-vision-20260920/exports/
!docs/verification/hex-vision-20260920/exports/**
!docs/verification/hex-small-grid-20260921/.godot/
!docs/verification/hex-small-grid-20260921/.godot/**
docs/verification/**/isolated-roaming/
docs/verification/**/imported/
docs/verification/**/shader_cache/
docs/verification/**/*.exe
docs/verification/**/*.pck
docs/verification/**/*.zip

# Import recipes inside the declared runtime identity are source inputs, not caches.
!src/**/*.import
!content/**/*.import
!scenes/**/*.import
!addons/**/*.import
!assets/**/*.import
!art_batches/pixel_v1/magic/export/**/*.import
!art_batches/pixel_v1/map/export/**/*.import
!art_batches/wellspring_style_v2/runtime/**/*.import
